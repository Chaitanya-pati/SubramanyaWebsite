        ::-webkit-scrollbar-thumb { background: #0f766e; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #14b8a6; }

        .glass-panel {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        .dark .glass-panel {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(30, 41, 59, 0.8);
        }

        .hover-lift {
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
        }
        .hover-lift:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px -15px rgba(15, 118, 110, 0.2);
        }

        .service-tab-btn.active, .gallery-filter-btn.active {
            background-color: #0f766e !important;
            color: #ffffff !important;
            border-color: #0f766e !important;
        }

        .swiper-pagination-bullet { width: 10px; height: 10px; background: #14b8a6; opacity: 0.4; transition: all 0.3s ease; }
        .swiper-pagination-bullet-active { width: 28px; border-radius: 6px; opacity: 1; background: #0f766e; }

        .faq-item.active { border-color: #14b8a6 !important; box-shadow: 0 10px 25px -5px rgba(20, 184, 166, 0.1); }
        .faq-item.active .faq-icon { transform: rotate(45deg); background-color: #0f766e; color: #ffffff; }

        @@keyframes float { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-8px); } }
        .animate-float { animation: float 4s ease-in-out infinite; }

        @@keyframes pulseGlow { 0%, 100% { box-shadow: 0 0 15px rgba(20, 184, 166, 0.3); } 50% { box-shadow: 0 0 30px rgba(20, 184, 166, 0.7); } }
        .animate-pulse-glow { animation: pulseGlow 2.5s infinite; }

        @@media (max-width: 640px) {
            h1 { font-size: 2.25rem !important; line-height: 1.2 !important; }
            .service-card { padding: 1.5rem !important; }
        }
    </style>

