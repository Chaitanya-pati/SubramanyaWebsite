        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/lightgallery.min.js"></script>
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>

    <!-- Complete Integrated App JavaScript -->
    <script>
        // Theme Toggle
        const themeToggleBtn = document.getElementById('themeToggle');
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
        themeToggleBtn.addEventListener('click', () => {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.theme = 'light';
            } else {
                document.documentElement.classList.add('dark');
                localStorage.theme = 'dark';
            }
        });

        // Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileDrawer = document.getElementById('mobileDrawer');
        mobileMenuBtn.addEventListener('click', () => {
            mobileDrawer.classList.toggle('hidden');
        });

        // Service Filter
        function filterServices(category) {
            const cards = document.querySelectorAll('.service-card');
            const btns = document.querySelectorAll('.service-tab-btn');

            btns.forEach(b => b.classList.remove('active', 'bg-teal-600', 'text-white'));
            event.target.classList.add('active', 'bg-teal-600', 'text-white');

            cards.forEach(card => {
                if (category === 'all' || card.dataset.category === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Form Select Sync
        function selectServiceInForm(serviceName) {
            const select = document.getElementById('RequiredService');
            if (select) {
                select.value = serviceName;
            }
        }

        // FAQ Toggle
        function toggleFaq(element) {
            const answer = element.querySelector('.faq-answer');
            const icon = element.querySelector('.faq-icon i');
            if (answer.classList.contains('hidden')) {
                answer.classList.remove('hidden');
                icon.className = 'fa-solid fa-minus';
                element.classList.add('active');
            } else {
                answer.classList.add('hidden');
                icon.className = 'fa-solid fa-plus';
                element.classList.remove('active');
            }
        }

        // Form submission feedback
        function showBookingModal(type, title, message) {
            const modal = document.getElementById('bookingModal');
            const icon = document.getElementById('bookingModalIcon');
            const action = document.getElementById('bookingModalAction');
            const isSuccess = type === 'success';

            icon.className = `mx-auto mb-4 w-14 h-14 rounded-full flex items-center justify-center text-xl ${
                isSuccess
                    ? 'bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300'
                    : 'bg-rose-100 dark:bg-rose-950 text-rose-600 dark:text-rose-300'
            }`;
            icon.innerHTML = isSuccess
                ? '<i class="fa-solid fa-check"></i>'
                : '<i class="fa-solid fa-triangle-exclamation"></i>';
            action.textContent = isSuccess ? 'Done' : 'Try Again';
            document.getElementById('bookingModalTitle').textContent = title;
            document.getElementById('bookingModalMessage').textContent = message;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.classList.add('overflow-hidden');
            modal.querySelector('button').focus();
        }

        function closeBookingModal() {
            const modal = document.getElementById('bookingModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.classList.remove('overflow-hidden');
        }

        // Form Submission
        function submitCareForm(e) {
            e.preventDefault();
            const form = e.target;
            const submitButton = form.querySelector('button[type="submit"]');
            const name = document.getElementById('Name').value;
            const patient = document.getElementById('PatientName').value;
            const phone = document.getElementById('Phone').value;

            submitButton.disabled = true;
            submitButton.classList.add('opacity-60', 'cursor-wait');

            fetch('/Home/BookCare', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams(new FormData(form))
            })
            .then(async res => {
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.success) {
                    throw new Error(data.message || 'We could not send your request.');
                }
                return data;
            })
            .then(data => {
                showBookingModal(
                    'success',
                    'Request accepted',
                    data.message || `Thank you ${name}. Your request for ${patient} has been received. Our team will contact you at ${phone} shortly.`
                );
                form.reset();
            })
            .catch(err => {
                showBookingModal(
                    'error',
                    'Request not sent',
                    err.message || `We could not send your request. Please call ${phone}.`
                );
            })
            .finally(() => {
                submitButton.disabled = false;
                submitButton.classList.remove('opacity-60', 'cursor-wait');
            });
        }

        // Initialize Swiper, LightGallery, AOS
        document.addEventListener('DOMContentLoaded', () => {
            AOS.init({ duration: 800, once: true });

            new Swiper('.testimonialSwiper', {
                slidesPerView: 1,
                spaceBetween: 24,
                pagination: { el: '.swiper-pagination', clickable: true },
                breakpoints: {
                    640: { slidesPerView: 2 },
                    1024: { slidesPerView: 3 }
                }
            });

            if (document.getElementById('lightgallery')) {
                lightGallery(document.getElementById('lightgallery'), {
                    selector: '.gallery-item',
                    download: false
                });
            }

            // Counter Animation
            const counters = document.querySelectorAll('#counterSection [data-target]');
            let animated = false;
            window.addEventListener('scroll', () => {
                const section = document.getElementById('counterSection');
                if (!section || animated) return;
                const pos = section.getBoundingClientRect();
                if (pos.top < window.innerHeight && pos.bottom >= 0) {
                    animated = true;
                    counters.forEach(counter => {
                        const target = +counter.getAttribute('data-target');
                        let count = 0;
                        const inc = target / 40;
                        const update = () => {
                            count += inc;
                            if (count < target) {
                                counter.innerText = Math.ceil(count);
                                setTimeout(update, 30);
                            } else {
                                counter.innerText = target;
                            }
                        };
                        update();
                    });
                }
            });
        });
    </script>
</body>
</html>
